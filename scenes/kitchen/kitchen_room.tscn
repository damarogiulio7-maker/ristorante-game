[sub_resource type="GDScript" id="floor_tile_script"]
script/source = "extends Polygon2D

## Singolo rombo del pavimento isometrico, disegnato via codice come
## placeholder finché non ci sono sprite veri.

func _init() -> void:
	var w := 64.0
	var h := 32.0
	polygon = PackedVector2Array([
		Vector2(0, -h / 2.0),
		Vector2(w / 2.0, 0),
		Vector2(0, h / 2.0),
		Vector2(-w / 2.0, 0),
	])
"

